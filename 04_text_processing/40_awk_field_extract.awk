# =============================================================================
# 脚本名称：01_field_extract.awk
# 功能描述：提取字段 - 从/etc/passwd 提取用户名
# 难度等级：⭐⭐ 入门
# 知识点：
#   - BEGIN 块（处理前初始化）
#   - END 块（处理后执行）
#   - FS 设置字段分隔符
#   - $1 提取第一个字段
#   - print 输出
# 使用方法：
#   awk -f 01_field_extract.awk /etc/passwd
#   或：cat /etc/passwd | awk -f 01_field_extract.awk
# 示例输出：
#   root
#   bin
#   daemon
#   ...
# =============================================================================

# BEGIN 块：在处理任何输入行之前执行
BEGIN	{
	# 设置字段分隔符为冒号
	# /etc/passwd 文件用冒号分隔字段
	FS=":"
}

# 主块：对每一行执行
# 没有条件，表示对所有行执行
{
	# 打印第一个字段（用户名）
	# $1 表示第一个字段
	print $1
}

# END 块：在处理所有输入行之后执行
END	{
	# 这里可以添加结束时的操作
	# 目前是空的
}

# 说明：
# 1. awk 有三个处理块：BEGIN, 主块，END
# 2. BEGIN 只执行一次，在读取任何行之前
# 3. 主块对每一行执行
# 4. END 只执行一次，在处理完所有行之后
# 5. FS 是 Field Separator（字段分隔符）
# 6. $1, $2, $3... 分别表示第 1, 2, 3...个字段

# /etc/passwd 格式：
# 用户名：密码占位符：UID:GID:描述：家目录：登录 shell
# root:x:0:0:root:/root:/bin/bash
