# =============================================================================
# 脚本名称：02_condition_filter.awk
# 功能描述：条件过滤 - 统计字段数大于 7 的行数
# 难度等级：⭐⭐⭐ 中级
# 知识点：
#   - BEGIN 块初始化变量
#   - NF 内置变量（字段数）
#   - if 条件判断
#   - 累加计数
#   - END 块输出结果
# 使用方法：
#   awk -f 02_condition_filter.awk /etc/passwd
#   或：cat /etc/passwd | awk -f 02_condition_filter.awk
# 功能说明：
#   统计/etc/passwd 中字段数大于 7 的行数
# =============================================================================

# BEGIN 块：初始化
BEGIN	{
	# 设置字段分隔符为冒号
	FS=":"
	
	# 初始化计数器
	sum=0
}

# 主块：对每一行执行
{
	# 如果字段数大于 7
	# NF 是 Number of Fields（字段数）
	if (NF>7)
		# 计数器加 1
		sum=sum+1
}

# END 块：输出结果
END	{
	# 打印符合条件的总行数
	print sum
}

# 说明：
# 1. NF 是 awk 的内置变量，表示当前行的字段数
# 2. if (NF>7) 判断字段数是否大于 7
# 3. sum=sum+1 累加符合条件的行数
# 4. END 块输出最终统计结果

# /etc/passwd 字段说明：
# 1. 用户名
# 2. 密码占位符（x）
# 3. UID
# 4. GID
# 5. 用户描述/GECOS
# 6. 家目录
# 7. 登录 shell
# 8+. 额外字段（某些系统有）

# 示例输出：
# 3  # 表示有 3 行字段数大于 7
