# =============================================================================
# 脚本名称：03_loop_calc.awk
# 功能描述：循环计算 - 统计符合条件的行数和字段数
# 难度等级：⭐⭐⭐⭐ 高级
# 知识点：
#   - BEGIN 块初始化多个变量
#   - NF 字段数
#   - NR 行号（Number of Record）
#   - && 逻辑与
#   - % 取模运算
#   - 多条件组合
#   - \n 换行符
# 使用方法：
#   awk -f 03_loop_calc.awk /etc/passwd
#   或：cat /etc/passwd | awk -f 03_loop_calc.awk
# 功能说明：
#   统计字段数在 5-8 之间且行号为奇数的行
#   输出符合条件的总行数和总字段数
# =============================================================================

# BEGIN 块：初始化变量
BEGIN	{
	# 设置字段分隔符为冒号
	FS=":"
	
	# 初始化行数计数器
	line=0
	
	# 初始化字段数计数器
	field=0
}

# 主块：条件过滤
# NF>5 && NF<8 字段数大于 5 且小于 8（即 6 或 7 个字段）
# NR%2==1 行号是奇数（行号除以 2 余 1）
NF>5 && NF<8 && NR%2==1 {
	# 行数加 1
	line=line+1
	
	# 累加字段数
	field=field+NF
}

# END 块：输出结果
END	{
	# 打印统计结果
	# \n 表示换行
	# "符合的总行数为:" 和 "符合的总列数为:" 是中文提示
	print "符合的总行数为:"line"\n符合的总列数为:"field
}

# 说明：
# 1. NF 是字段数（Number of Fields）
# 2. NR 是行号（Number of Record），从 1 开始
# 3. && 表示逻辑与（and），所有条件都要满足
# 4. % 是取模运算符，NR%2==1 表示奇数行
# 5. line=line+1 累加行数
# 6. field=field+NF 累加字段数

# 条件解释：
# NF>5 && NF<8  => 字段数为 6 或 7
# NR%2==1       => 行号是奇数（第 1, 3, 5, 7...行）

# 示例输出：
# 符合的总行数为:5
# 符合的总列数为:35

# 扩展：
# 1. 可以修改条件为其他范围
# 2. 可以添加更多统计指标
# 3. 可以输出详细信息
